# HotelPro Server — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Server port (Render sets this automatically in production)
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/hotelpro
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotelpro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hotelpro

# Frontend URL for CORS (no trailing slash)
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

# JWT secret — use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret

# JWT expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (TEST Mode credentials)
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Generate Key)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret
# Configure in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://your-server.onrender.com/api/payments/webhook
# Secret: Generate a random string (e.g. openssl rand -hex 16) and enter both here and in the dashboard
# Active Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
